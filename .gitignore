# Tool caches, not content.
.ruff_cache/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/

# Local agent settings, which are per-machine.
.claude/settings.local.json

# Local editor settings.
.vscode/

# Editor lock files: Emacs writes .#name as a symlink to user@host:pid, which points at
# nothing and breaks any sweep that follows it.
.#*
