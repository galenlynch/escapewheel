{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://escapewheel.org/schemas/manifest/0.3.0",
  "title": "Escapewheel packet manifest",
  "description": "Shape of packet.json. Physical interfaces derive from the selected profile and each declaration's logical kind; format-owned metadata remains in the resource.",
  "type": "object",
  "required": [
    "packet_id",
    "packet_version",
    "profile_id",
    "semantic_standard_version",
    "logical_standard_version",
    "registry_version",
    "created_at",
    "sessions",
    "resources",
    "validation"
  ],
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "creators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataset_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "extensions": {
      "description": "Extension registries this packet carries (Part 09 \u00a75.3). Each is a registry document in Part 02's format, namespaced by its extension_id. A core validator verifies the declared file exists and MUST NOT require its schema.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "registry"
        ],
        "properties": {
          "version": {
            "description": "The extension registry's own registry_version.",
            "type": "string"
          },
          "registry": {
            "description": "Where the registry document lives, relative to the packet root.",
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string"
    },
    "logical_standard_version": {
      "type": "string"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "profile_id": {
      "const": "escapewheel-portable-v0.1"
    },
    "provenance": {
      "description": "Optional; provenance is SHOULD, not MUST.",
      "type": "object",
      "properties": {
        "source_files_resource": {
          "type": "string"
        },
        "processing_runs_resource": {
          "type": "string"
        },
        "processing_run_inputs_resource": {
          "type": "string"
        },
        "import_processing_run_id": {
          "type": "string"
        }
      }
    },
    "registry_version": {
      "description": "The registry this packet was written against.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "release_id": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "retention": {
      "type": "object",
      "description": "How many superseded manifests this packet retains, and for how long. Both are floors: a manifest is expired only when both permit it. Absent means the defaults, one kept version and no age limit.",
      "properties": {
        "keep_versions": {
          "type": "integer",
          "minimum": 0,
          "description": "Superseded manifests to retain. Default 1."
        },
        "keep_days": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Drop a superseded manifest older than this. Absent means age alone never expires one."
        }
      },
      "additionalProperties": false
    },
    "semantic_standard_version": {
      "type": "string"
    },
    "sessions": {
      "description": "Every session in the packet. One entry in the primary single-session case.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_summary": {
      "type": "object"
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "validated_at",
        "validator_name",
        "validator_version"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "validated_at": {
          "type": "string",
          "format": "date-time"
        },
        "validator_name": {
          "type": "string"
        },
        "validator_version": {
          "type": "string"
        },
        "report_uri": {
          "type": "string"
        }
      }
    }
  },
  "not": {"required": ["required_codecs"]},
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "resource_id",
        "declaration_id",
        "uri"
      ],
      "properties": {
        "resource_id": {
          "type": "string"
        },
        "declaration_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "semantic_type": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "validation_state": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "processing_run_id": {
          "description": "The run that produced this resource.",
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "description": "The body of data this external resource belongs to. Its uri is then a path relative to wherever that source is, located by a source resolution document rather than by the packet. Names no location itself.",
          "type": "string"
        },
        "external": {
          "description": "True when the packet does not own these bytes. Required wherever uri is absolute. Immutability and checksums cover packet-owned bytes only.",
          "type": "boolean"
        },
        "size_bytes": {
          "description": "As verified at validation time.",
          "type": "integer",
          "minimum": 0
        },
        "verified_at": {
          "description": "When sha256 or size_bytes last held. Not a promise about now.",
          "type": "string",
          "format": "date-time"
        },
        "members": {
          "description": "What a prefix held when someone looked. A record, not a resolution rule: a reader hands an external prefix to its own library, which addresses members by key and never enumerates. Optional, and only meaningful where uri names a prefix.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "size_bytes"
            ],
            "properties": {
              "key": {
                "description": "Relative to uri, with / separators.",
                "type": "string",
                "minLength": 1
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "store_digest": {
                "description": "What the store itself said about this member, in the store's own algorithm. Never a substitute for sha256: it answers whether anything has changed in place, not whether these are the bytes.",
                "type": "object",
                "required": [
                  "algorithm",
                  "value"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "anyOf": [
              {"required": ["layer"]},
              {"required": ["kind"]},
              {"required": ["canonical"]},
              {"required": ["schema_id"]},
              {"required": ["extension_id"]},
              {"required": ["catalog_table_ref"]},
              {"required": ["array_asset_id"]},
              {"required": ["media_asset_id"]}
            ]
          }
        },
        {
          "if": {
            "properties": {
              "uri": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*://"
              }
            },
            "required": [
              "uri"
            ]
          },
          "then": {
            "properties": {
              "external": {
                "const": true
              }
            },
            "required": [
              "external"
            ]
          }
        }
      ]
    }
  }
}
