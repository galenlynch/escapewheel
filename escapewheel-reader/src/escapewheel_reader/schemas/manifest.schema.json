{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://escapewheel.org/schemas/manifest/0.1.0",
  "title": "Escapewheel packet manifest",
  "description": "Shape of packet.json. Covers Part 04's fields, including sessions and required_codecs, with the current provenance names.",
  "type": "object",
  "required": [
    "packet_id",
    "packet_version",
    "profile_id",
    "semantic_standard_version",
    "logical_standard_version",
    "registry_version",
    "created_at",
    "sessions",
    "required_codecs",
    "resources",
    "validation"
  ],
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "creators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataset_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "extensions": {
      "description": "Extension registries this packet carries (Part 09 \u00a75.3). Each is a registry document in Part 02's format, namespaced by its extension_id. A core validator verifies the declared file exists and MUST NOT require its schema.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "registry"
        ],
        "properties": {
          "version": {
            "description": "The extension registry's own registry_version.",
            "type": "string"
          },
          "registry": {
            "description": "Where the registry document lives, relative to the packet root.",
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string"
    },
    "logical_standard_version": {
      "type": "string"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "profile_id": {
      "const": "escapewheel-portable-v0.1"
    },
    "provenance": {
      "description": "Optional; provenance is SHOULD, not MUST.",
      "type": "object",
      "properties": {
        "source_files_resource": {
          "type": "string"
        },
        "processing_runs_resource": {
          "type": "string"
        },
        "processing_run_inputs_resource": {
          "type": "string"
        },
        "import_processing_run_id": {
          "type": "string"
        }
      }
    },
    "registry_version": {
      "description": "The registry this packet was written against.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "release_id": {
      "type": "string"
    },
    "required_codecs": {
      "description": "The union of every resource's codecs. Answers whether a reader can use the whole packet; it does not gate individual reads.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "retention": {
      "type": "object",
      "description": "How many superseded manifests this packet retains, and for how long. Both are floors: a manifest is expired only when both permit it. Absent means the defaults, one kept version and no age limit.",
      "properties": {
        "keep_versions": {
          "type": "integer",
          "minimum": 0,
          "description": "Superseded manifests to retain. Default 1."
        },
        "keep_days": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Drop a superseded manifest older than this. Absent means age alone never expires one."
        }
      },
      "additionalProperties": false
    },
    "semantic_standard_version": {
      "type": "string"
    },
    "sessions": {
      "description": "Every session in the packet. One entry in the primary single-session case.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_summary": {
      "type": "object"
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "validated_at",
        "validator_name",
        "validator_version"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "validated_at": {
          "type": "string",
          "format": "date-time"
        },
        "validator_name": {
          "type": "string"
        },
        "validator_version": {
          "type": "string"
        },
        "report_uri": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "resource_id",
        "layer",
        "kind",
        "uri"
      ],
      "properties": {
        "resource_id": {
          "type": "string"
        },
        "layer": {
          "enum": [
            "core",
            "analysis",
            "extension",
            "docs"
          ]
        },
        "kind": {
          "enum": [
            "table",
            "materialized_table",
            "dense_array_asset",
            "media_asset",
            "document_asset",
            "view"
          ]
        },
        "semantic_type": {
          "type": "string"
        },
        "schema_id": {
          "type": "string"
        },
        "physical_profile": {
          "enum": [
            "parquet",
            "parquet_dataset",
            "zarr_v2",
            "zarr_v3",
            "markdown",
            "json",
            "text",
            "pdf",
            "mp4"
          ],
          "description": "Physical encoding of this resource. zarr_v2 is permitted only for an external resource; a packet-owned array MUST be zarr_v3. The version is part of the profile because readability is a property of the (version, codec) pair, not of the codec alone."
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "partitioning": {
          "description": "Present when physical_profile is parquet_dataset.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "canonical": {
          "type": "boolean"
        },
        "validation_state": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "processing_run_id": {
          "description": "The run that produced this resource.",
          "type": "string"
        },
        "catalog_table_ref": {
          "type": "string"
        },
        "array_asset_id": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "description": "The body of data this external resource belongs to. Its uri is then a path relative to wherever that source is, located by a source resolution document rather than by the packet. Names no location itself.",
          "type": "string"
        },
        "external": {
          "description": "True when the packet does not own these bytes. Required wherever uri is absolute. Immutability and checksums cover packet-owned bytes only.",
          "type": "boolean"
        },
        "size_bytes": {
          "description": "As verified at validation time.",
          "type": "integer",
          "minimum": 0
        },
        "verified_at": {
          "description": "When sha256 or size_bytes last held. Not a promise about now.",
          "type": "string",
          "format": "date-time"
        },
        "members": {
          "description": "What a prefix held when someone looked. A record, not a resolution rule: a reader hands an external prefix to its own library, which addresses members by key and never enumerates. Optional, and only meaningful where uri names a prefix.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "size_bytes"
            ],
            "properties": {
              "key": {
                "description": "Relative to uri, with / separators.",
                "type": "string",
                "minLength": 1
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "store_digest": {
                "description": "What the store itself said about this member, in the store's own algorithm. Never a substitute for sha256: it answers whether anything has changed in place, not whether these are the bytes.",
                "type": "object",
                "required": [
                  "algorithm",
                  "value"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "codecs": {
          "description": "Zarr codecs this resource's array uses, excluding the mandatory bytes codec. A reader checks these before opening this resource and must not refuse the packet over a codec used only by resources it does not open.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "extension_id": {
          "description": "Which extension owns this resource; required when layer is extension.",
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "physical_profile": {
                "const": "parquet_dataset"
              }
            },
            "required": [
              "physical_profile"
            ]
          },
          "then": {
            "required": [
              "partitioning"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "uri": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*://"
              }
            },
            "required": [
              "uri"
            ]
          },
          "then": {
            "properties": {
              "external": {
                "const": true
              }
            },
            "required": [
              "external"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "dense_array_asset"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "codecs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "layer": {
                "const": "extension"
              }
            },
            "required": [
              "layer"
            ]
          },
          "then": {
            "required": [
              "extension_id"
            ]
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "physical_profile": {
                    "const": "zarr_v2"
                  }
                },
                "required": [
                  "physical_profile"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "external": {
                "const": true
              }
            },
            "required": [
              "external"
            ]
          }
        }
      ]
    }
  }
}
