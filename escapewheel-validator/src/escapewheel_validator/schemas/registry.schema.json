{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://escapewheel.org/schemas/registry/0.4.0",
  "title": "Escapewheel schema registry",
  "description": "Local shape of an Escapewheel core or extension registry document.",
  "type": "object",
  "required": ["$schema", "registry_version", "logical_standard_version", "rule_language", "tables"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "registry_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "semantic_standard_version": {"$ref": "#/$defs/standard_id"},
    "logical_standard_version": {"$ref": "#/$defs/standard_id"},
    "rule_language": {"$ref": "#/$defs/standard_id"},
    "extension_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "not": {"enum": ["core", "analysis", "nwb"]}
    },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/table"}
    }
  },
  "oneOf": [
    {"required": ["semantic_standard_version"], "not": {"required": ["extension_id"]}},
    {"required": ["extension_id"], "not": {"required": ["semantic_standard_version"]}}
  ],
  "$defs": {
    "standard_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-v[0-9]+(?:\\.[0-9]+)*$"
    },
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "table": {
      "type": "object",
      "required": ["columns", "primary_key", "references", "rules"],
      "additionalProperties": false,
      "properties": {
        "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/column"}},
        "primary_key": {
          "oneOf": [
            {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
            {"type": "null"}
          ]
        },
        "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
      }
    },
    "column": {
      "type": "object",
      "required": ["name", "type", "presence", "role"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "type": {"enum": ["string", "int32", "int64", "float32", "float64", "bool", "date", "timestamp", "json_string"]},
        "presence": {"enum": ["required", "nullable", "optional"]},
        "role": {"enum": ["data", "identifier", "coordinate", "structural_index", "sequence_position", "discriminator"]},
        "identity": {"enum": ["carried", "assigned"]},
        "resolves": {"enum": ["required", "optional"]},
        "discriminates": {"$ref": "#/$defs/name"},
        "positions_in": {"$ref": "#/$defs/name"},
        "discriminates_via": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
        "description": {"type": "string"},
        "vocabulary": {"enum": ["closed", "open", "free"]},
        "enum": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "reserved_values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "determined_by": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
        "unit": {"type": "string", "minLength": 1},
        "unit_from": {"$ref": "#/$defs/context_source"},
        "clock_from": {"$ref": "#/$defs/context_source"},
        "authority": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/authority"}}
      },
      "allOf": [
        {
          "if": {"properties": {"role": {"const": "identifier"}}, "required": ["role"]},
          "then": {"required": ["identity"]},
          "else": {"not": {"required": ["identity"]}}
        },
        {
          "if": {"properties": {"role": {"const": "coordinate"}}, "required": ["role"]},
          "then": {"properties": {"type": {"const": "int64"}}}
        },
        {
          "if": {"properties": {"role": {"const": "discriminator"}}, "required": ["role"]},
          "then": {
            "required": ["resolves"],
            "properties": {"type": {"const": "string"}, "presence": {"enum": ["required", "nullable"]}},
            "not": {"required": ["vocabulary"]}
          },
          "else": {
            "not": {"anyOf": [
              {"required": ["resolves"]},
              {"required": ["discriminates"]},
              {"required": ["positions_in"]},
              {"required": ["discriminates_via"]}
            ]}
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "string"}, "role": {"not": {"const": "discriminator"}}},
            "required": ["type", "role"]
          },
          "then": {"required": ["vocabulary"]}
        },
        {
          "if": {"properties": {"type": {"not": {"const": "string"}}}, "required": ["type"]},
          "then": {"not": {"anyOf": [
            {"required": ["vocabulary"]},
            {"required": ["enum"]},
            {"required": ["reserved_values"]},
            {"required": ["authority"]}
          ]}}
        },
        {
          "if": {"required": ["enum"]},
          "then": {"required": ["vocabulary"], "properties": {"vocabulary": {"const": "closed"}}}
        },
        {
          "if": {"properties": {"vocabulary": {"const": "closed"}}, "required": ["vocabulary"]},
          "then": {"required": ["enum"]}
        },
        {
          "if": {"required": ["reserved_values"]},
          "then": {"required": ["vocabulary"], "properties": {"vocabulary": {"const": "open"}}}
        },
        {
          "if": {"properties": {"vocabulary": {"const": "open"}}, "required": ["vocabulary"]},
          "then": {"required": ["description"], "properties": {"description": {"minLength": 1}}}
        },
        {"not": {"required": ["unit", "unit_from"]}},
        {
          "if": {"required": ["clock_from"]},
          "then": {"properties": {"role": {"const": "coordinate"}}}
        },
        {
          "if": {"properties": {"type": {"const": "json_string"}}, "required": ["type"]},
          "then": {"properties": {"presence": {"const": "optional"}}}
        },
        {
          "if": {"properties": {"name": {"const": "metadata"}}, "required": ["name"]},
          "then": {"properties": {"type": {"const": "json_string"}, "presence": {"const": "optional"}, "role": {"const": "data"}}}
        },
        {
          "if": {"properties": {"role": {"const": "identifier"}}, "required": ["role"]},
          "then": {"properties": {"name": {"pattern": "_id$"}}}
        },
        {
          "if": {"properties": {"name": {"pattern": "_id$"}}, "required": ["name"]},
          "then": {"properties": {"type": {"enum": ["int32", "int64"]}, "role": {"const": "identifier"}}}
        },
        {
          "if": {"properties": {"role": {"const": "coordinate"}}, "required": ["role"]},
          "then": {"properties": {"name": {"pattern": "_tick$"}}}
        },
        {
          "if": {"properties": {"name": {"pattern": "_tick$"}}, "required": ["name"]},
          "then": {"properties": {"role": {"const": "coordinate"}}}
        },
        {
          "if": {"properties": {"role": {"const": "structural_index"}}, "required": ["role"]},
          "then": {"properties": {"name": {"pattern": "_index$"}}}
        },
        {
          "if": {"properties": {"name": {"pattern": "_index$"}}, "required": ["name"]},
          "then": {"properties": {"role": {"enum": ["structural_index", "sequence_position"]}}}
        },
        {
          "if": {"properties": {"name": {"pattern": "_name$"}}, "required": ["name"]},
          "then": {"properties": {"type": {"const": "string"}}}
        },
        {
          "if": {"properties": {"name": {"pattern": "(^uri$|_uri$)"}}, "required": ["name"]},
          "then": {"properties": {"type": {"const": "string"}}}
        }
      ]
    },
    "context_source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*)?$"
    },
    "authority": {
      "type": "object",
      "required": ["name", "uri"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1}, "uri": {"type": "string", "format": "uri"}}
    },
    "reference": {
      "type": "object",
      "required": ["columns", "resource", "resource_columns"],
      "additionalProperties": false,
      "properties": {
        "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
        "resource": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
        "resource_columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "level", "message", "sql"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "level": {"enum": ["error", "warning", "info"]},
        "message": {"type": "string"},
        "sql": {"type": "string", "minLength": 1},
        "advisory": {"type": "boolean", "default": false}
      },
      "allOf": [{
        "if": {"properties": {"advisory": {"const": true}}, "required": ["advisory"]},
        "then": {"properties": {"level": {"enum": ["warning", "info"]}}}
      }]
    }
  }
}
