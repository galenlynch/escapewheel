{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://escapewheel.org/schemas/resources/0.4.0",
  "title": "Escapewheel resource document",
  "description": "Shape of the document an adapter delivers alongside its rows to describe the resources it references rather than writes (Part 03 \u00a711.3). Generated from the manifest schema by registry/build.py: each entry is a manifest resource entry without the members a build supplies.",
  "type": "object",
  "required": [
    "resources"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "This document's schema, by $id. Identity rather than a fetch instruction.",
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "resource_id",
        "declaration_id",
        "uri"
      ],
      "properties": {
        "resource_id": {
          "$ref": "#/$defs/resource_id"
        },
        "declaration_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "uri": {
          "description": "Relative to the packet root, or to the source `source` names, unless absolute.",
          "type": "string",
          "minLength": 1
        },
        "external": {
          "description": "True when the packet does not own these bytes. Required wherever uri is absolute.",
          "type": "boolean"
        },
        "source": {
          "description": "The body of data this external resource belongs to (Part 04 \u00a75.5). Names no location itself.",
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "description": "As verified at validation time.",
          "type": "integer",
          "minimum": 0
        },
        "verified_at": {
          "description": "When sha256 or size_bytes last held. Not a promise about now.",
          "type": "string",
          "format": "date-time"
        },
        "members": {
          "description": "What a prefix held when someone looked. A record, not a resolution rule (Part 04 \u00a75.4).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "uri": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*://"
              }
            },
            "required": [
              "uri"
            ]
          },
          "then": {
            "properties": {
              "external": {
                "const": true
              }
            },
            "required": [
              "external"
            ]
          }
        },
        {
          "if": {
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "external": {
                "const": true
              }
            },
            "required": [
              "external"
            ]
          }
        }
      ]
    },
    "member": {
      "type": "object",
      "required": [
        "key",
        "size_bytes"
      ],
      "properties": {
        "key": {
          "description": "Relative to uri, with / separators.",
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "store_digest": {
          "description": "What the store itself said about this member, in the store's own algorithm. Never a substitute for sha256.",
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_.-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
