{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://escapewheel.org/schemas/resources/0.5.0",
  "title": "Escapewheel resource document",
  "description": "Shape of the document an adapter delivers alongside its rows to describe the resources it references rather than writes (Part 12 \u00a75). Generated from the manifest schema: each entry is a manifest resource entry without the members a build supplies.",
  "type": "object",
  "required": [
    "resources"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "This document's schema, by $id. Identity rather than a fetch instruction.",
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "resource_id",
        "declaration_id",
        "uri"
      ],
      "properties": {
        "resource_id": {
          "$ref": "#/$defs/resource_id"
        },
        "declaration_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "uri": {
          "description": "Relative to the packet root, or to the source `source` names, unless absolute.",
          "type": "string",
          "minLength": 1
        },
        "external": {
          "description": "True when the packet does not own these bytes. Required wherever uri is absolute.",
          "type": "boolean"
        },
        "source": {
          "description": "The body of data this external resource belongs to (Part 04 \u00a75.5). Names no location itself.",
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size_bytes": {
          "description": "As verified at validation time.",
          "type": "integer",
          "minimum": 0
        },
        "verified_at": {
          "description": "When digest or size_bytes last held. Not a promise about now.",
          "type": "string",
          "format": "date-time"
        },
        "members": {
          "description": "What a prefix held when someone looked. A record, not a resolution rule (Part 04 \u00a75.4).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "uri": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*://"
              }
            },
            "required": [
              "uri"
            ]
          },
          "then": {
            "properties": {
              "external": {
                "const": true
              }
            },
            "required": [
              "external"
            ]
          }
        },
        {
          "if": {
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "external": {
                "const": true
              }
            },
            "required": [
              "external"
            ]
          }
        },
        {
          "if": {
            "required": [
              "digest",
              "members"
            ]
          },
          "then": {
            "properties": {
              "members": {
                "items": {
                  "required": [
                    "digest"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "digest"
              ]
            }
          },
          "then": {
            "properties": {
              "members": {
                "items": {
                  "not": {
                    "required": [
                      "digest"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "digest"
            ],
            "properties": {
              "digest": {
                "required": [
                  "algorithm"
                ],
                "properties": {
                  "algorithm": {
                    "const": "sha256"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "members": {
                "items": {
                  "properties": {
                    "digest": {
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "digest"
            ],
            "properties": {
              "digest": {
                "required": [
                  "algorithm"
                ],
                "properties": {
                  "algorithm": {
                    "const": "crc64nvme"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "members": {
                "items": {
                  "properties": {
                    "digest": {
                      "pattern": "^[0-9a-f]{16}$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "digest"
            ],
            "properties": {
              "digest": {
                "required": [
                  "algorithm"
                ],
                "properties": {
                  "algorithm": {
                    "enum": [
                      "crc32c",
                      "crc32"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "members": {
                "items": {
                  "properties": {
                    "digest": {
                      "pattern": "^[0-9a-f]{8}$"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "digest": {
      "description": "A digest of a resource's bytes under a named function (Part 04 \u00a74.3). A prefix's value is the SHA-256 of its listing under every algorithm.",
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "crc64nvme",
            "crc32c",
            "crc32"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "algorithm"
            ],
            "properties": {
              "algorithm": {
                "const": "sha256"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "algorithm"
            ],
            "properties": {
              "algorithm": {
                "const": "crc64nvme"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^(?:[0-9a-f]{16}|[0-9a-f]{64})$"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "algorithm"
            ],
            "properties": {
              "algorithm": {
                "enum": [
                  "crc32c",
                  "crc32"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^(?:[0-9a-f]{8}|[0-9a-f]{64})$"
              }
            }
          }
        }
      ]
    },
    "member": {
      "type": "object",
      "required": [
        "key",
        "size_bytes"
      ],
      "properties": {
        "key": {
          "description": "Relative to uri, with / separators.",
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "description": "This object's single-object value under its entry's algorithm (Part 04 \u00a74.3).",
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "store_digest": {
          "description": "Evidence that this object changed in place, in the store's own terms; an entity tag is recorded verbatim under `etag` (Part 04 \u00a75.4). Never establishes that a digest holds.",
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_.-]+$"
    }
  }
}
