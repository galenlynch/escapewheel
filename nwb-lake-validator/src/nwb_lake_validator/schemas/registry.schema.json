{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nwb-lake.org/schemas/registry/0.1.0",
  "title": "NWB-Lake schema registry",
  "description": "Shape of logical_schemas.json, per R2 \u00a79. Validates the registry document; column semantics are values within it, not JSON Schema types (R2 \u00a710).",
  "type": "object",
  "required": [
    "registry_version",
    "logical_standard_version",
    "tables"
  ],
  "additionalProperties": false,
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "semantic_standard_version": {
      "type": "string"
    },
    "logical_standard_version": {
      "type": "string"
    },
    "derived_from": {
      "type": "object",
      "description": "Optional record of how the registry was first produced.",
      "properties": {
        "specification": {
          "type": "string"
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^R\\d+$"
          }
        }
      }
    },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^([a-z][a-z0-9_]*)\\.[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/table"
      }
    },
    "extension_id": {
      "description": "Present on an extension registry; namespaces its tables (R17 \u00a72).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "extends": {
      "description": "The logical standard version this extension was written against (R17 \u00a75).",
      "type": "string"
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "required": [
        "columns",
        "primary_key",
        "references",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "primary_key": {
          "description": "Column names, or null for a table admitting duplicate rows (R7 \u00a72).",
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "sort": {
          "description": "Physical ordering a writer SHOULD apply (R2 \u00a76). Performance, not correctness.",
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "since": {
          "type": "string",
          "minLength": 1,
          "description": "The revision that introduced or last changed this, e.g. 'R8 \u00a72' (R29 \u00a72). A citation for a reader, not a link a validator resolves; absent means it came from 02 unamended."
        }
      }
    },
    "column": {
      "type": "object",
      "required": [
        "name",
        "type",
        "presence",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "description": "R2 \u00a74's Arrow-compatible vocabulary. Nested types are forbidden by R3 \u00a72.1.",
          "enum": [
            "string",
            "int32",
            "int64",
            "float32",
            "float64",
            "bool",
            "date",
            "timestamp",
            "json_string"
          ]
        },
        "presence": {
          "description": "R2 \u00a75. required: present, non-null. nullable: present, may be null. optional: may be absent.",
          "enum": [
            "required",
            "nullable",
            "optional"
          ]
        },
        "role": {
          "description": "R48 \u00a72.1. What kind of thing the column holds, which decides what a consumer may do with it -- notably whether a 1-based client converts it at the boundary (R3 \u00a76). Closed: a consumer derives behaviour from it, so an unrecognised value would be unsafe.",
          "enum": [
            "data",
            "identifier",
            "coordinate",
            "structural_index",
            "sequence_position"
          ]
        },
        "description": {
          "type": "string"
        },
        "enum": {
          "description": "Closed value set. A validator MUST reject values outside it.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "vocabulary": {
          "description": "Declared open (R8 \u00a74). A validator MUST NOT reject unrecognized values.",
          "const": "open"
        },
        "reserved_values": {
          "description": "Values with fixed meanings within an open vocabulary (R11 \u00a74). Not a closed set.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "since": {
          "type": "string",
          "minLength": 1,
          "description": "The revision that introduced or last changed this, e.g. 'R8 \u00a72' (R29 \u00a72). A citation for a reader, not a link a validator resolves; absent means it came from 02 unamended."
        },
        "determined_by": {
          "description": "Columns whose values determine this one, so that rows agreeing on them agree here. An empty list declares a constant. Used to decide whether a table's sort order puts duplicate primary keys next to each other: a sort column that is determined by key columns cannot separate two rows that share a key.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "identity": {
          "description": "R53 \u00a72.3. Whether an identifier's value is the source's own (`carried`) or a number this format chose (`assigned`). Not derivable -- a source may supply an integer that the writer replaces -- and it decides whether the table owes a `*_name`. Required where role is identifier, meaningless otherwise.",
          "enum": [
            "carried",
            "assigned"
          ]
        },
        "unit": {
          "description": "R56 \u00a72.1. The unit this column's values are in, where it does not vary. Open, as `core.sorting_runs.amplitude_unit` already is (R11 \u00a72).",
          "type": "string",
          "minLength": 1
        },
        "unit_from": {
          "description": "R56 \u00a72.1. The column carrying this column's unit, where it varies per row. Either a column of this table, or `resource.column` resolved through a reference this table declares -- one hop (R56 \u00a72.3).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*)?$"
        },
        "clock_from": {
          "description": "R56 \u00a72.2. The column holding the `clock_id` these ticks are on. Absent, the clock is the table's own `clock_id` where it has one. Coordinates only.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*)?$"
        }
      },
      "not": {
        "required": [
          "enum",
          "vocabulary"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "identifier"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "identity"
            ]
          },
          "else": {
            "not": {
              "required": [
                "identity"
              ]
            }
          }
        },
        {
          "not": {
            "required": [
              "unit",
              "unit_from"
            ]
          }
        },
        {
          "if": {
            "required": [
              "clock_from"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "const": "coordinate"
              }
            },
            "required": [
              "role"
            ]
          }
        }
      ]
    },
    "reference": {
      "type": "object",
      "required": [
        "columns",
        "resource",
        "resource_columns"
      ],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "resource": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*)\\.[a-z][a-z0-9_]*$"
        },
        "resource_columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "level",
        "message",
        "sql"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "level": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string"
        },
        "sql": {
          "description": "Returns offending rows; empty is a pass (R2 \u00a77.3).",
          "type": "string",
          "minLength": 1
        },
        "advisory": {
          "description": "Off by default; runs only when the caller asks (R26 \u00a73). Never `error`, so enabling advisories cannot change whether a packet passed.",
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "advisory": {
                "const": true
              }
            },
            "required": [
              "advisory"
            ]
          },
          "then": {
            "properties": {
              "level": {
                "enum": [
                  "warning",
                  "info"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
