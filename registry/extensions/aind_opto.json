{
  "$schema": "https://escapewheel.org/schemas/registry/0.7.0",
  "registry_id": "aind_opto",
  "registry_version": "0.7.0",
  "logical_standard_version": "escapewheel-logical-v0.1",
  "rule_language": "escapewheel-rule-sql-v0.1",
  "extension_id": "aind_opto",
  "resources": {
    "aind_opto.emissions": {
      "content_class": "extension",
      "kind": "table",
      "instances": {
        "mode": "singleton",
        "presence": "optional"
      },
      "requires": [],
      "lineage": "optional",
      "table": {
        "columns": [
          {
            "name": "session_id",
            "type": "int32",
            "presence": "required",
            "role": "identifier",
            "identity": "assigned",
            "description": "Session ID."
          },
          {
            "name": "epoch_id",
            "type": "int32",
            "presence": "required",
            "role": "identifier",
            "identity": "carried",
            "description": "The interval this emission belongs to."
          },
          {
            "name": "device_id",
            "type": "int32",
            "presence": "required",
            "role": "identifier",
            "identity": "assigned",
            "description": "The emitter, which core already models."
          },
          {
            "name": "power_mw",
            "type": "float64",
            "presence": "nullable",
            "role": "data",
            "finite": true,
            "description": "Power delivered by this emitter.",
            "unit": "mW"
          },
          {
            "name": "wavelength_nm",
            "type": "float64",
            "presence": "nullable",
            "role": "data",
            "finite": true,
            "description": "Wavelength of this emitter.",
            "unit": "nm"
          },
          {
            "name": "location",
            "type": "string",
            "presence": "nullable",
            "role": "data",
            "description": "Where this emitter delivered, in the rig's own words.",
            "vocabulary": "open"
          }
        ],
        "primary_key": [
          "session_id",
          "epoch_id",
          "device_id"
        ],
        "references": [
          {
            "columns": [
              "device_id"
            ],
            "resource": "core.devices",
            "resource_columns": [
              "device_id"
            ]
          },
          {
            "columns": [
              "session_id",
              "epoch_id"
            ],
            "resource": "aind_opto.stimulations",
            "resource_columns": [
              "session_id",
              "epoch_id"
            ]
          }
        ],
        "rules": []
      }
    },
    "aind_opto.stimulations": {
      "content_class": "extension",
      "kind": "table",
      "instances": {
        "mode": "singleton",
        "presence": "optional"
      },
      "requires": [],
      "lineage": "optional",
      "table": {
        "columns": [
          {
            "name": "session_id",
            "type": "int32",
            "presence": "required",
            "role": "identifier",
            "identity": "assigned",
            "description": "Session ID."
          },
          {
            "name": "epoch_id",
            "type": "int32",
            "presence": "required",
            "role": "identifier",
            "identity": "carried",
            "description": "The interval this describes, in core."
          },
          {
            "name": "protocol",
            "type": "string",
            "presence": "nullable",
            "role": "data",
            "description": "What the light was for, in the rig's own words: tagging and inactivation are the same measurement differently parameterised.",
            "vocabulary": "open"
          },
          {
            "name": "duration_s",
            "type": "float64",
            "presence": "nullable",
            "role": "data",
            "finite": true,
            "description": "How long the light was on.",
            "unit": "s"
          },
          {
            "name": "pulse_duration_s",
            "type": "float64",
            "presence": "nullable",
            "role": "data",
            "finite": true,
            "description": "One pulse, where the protocol pulses.",
            "unit": "s"
          },
          {
            "name": "frequency_hz",
            "type": "float64",
            "presence": "nullable",
            "role": "data",
            "finite": true,
            "description": "Pulse frequency, where the protocol pulses.",
            "unit": "Hz"
          },
          {
            "name": "ramping_down_s",
            "type": "float64",
            "presence": "nullable",
            "role": "data",
            "finite": true,
            "description": "Ramp-down time, where the protocol ramps.",
            "unit": "s"
          },
          {
            "name": "start_offset_s",
            "type": "float64",
            "presence": "nullable",
            "role": "data",
            "finite": true,
            "description": "Onset relative to the interval's start.",
            "unit": "s"
          },
          {
            "name": "end_offset_s",
            "type": "float64",
            "presence": "nullable",
            "role": "data",
            "finite": true,
            "description": "Offset relative to the interval's end.",
            "unit": "s"
          },
          {
            "name": "condition",
            "type": "string",
            "presence": "nullable",
            "role": "data",
            "description": "The rig's own condition label.",
            "vocabulary": "open"
          },
          {
            "name": "condition_probability",
            "type": "float64",
            "presence": "nullable",
            "role": "data",
            "finite": true,
            "description": "How often this condition was drawn."
          },
          {
            "name": "on_probability",
            "type": "float64",
            "presence": "nullable",
            "role": "data",
            "finite": true,
            "description": "How often the light was on at all."
          },
          {
            "name": "metadata",
            "type": "json_string",
            "presence": "optional",
            "role": "data",
            "description": "What the source stated about this row that the standard does not model, carried in the source's own vocabulary and read by no rule."
          }
        ],
        "primary_key": [
          "session_id",
          "epoch_id"
        ],
        "references": [
          {
            "columns": [
              "session_id"
            ],
            "resource": "core.sessions",
            "resource_columns": [
              "session_id"
            ]
          }
        ],
        "rules": [
          {
            "id": "aind_opto.stimulations.pulsing_needs_a_frequency",
            "level": "error",
            "message": "a pulse duration is recorded with no frequency, so the train is undefined",
            "sql": "SELECT session_id, epoch_id FROM aind_opto.stimulations WHERE pulse_duration_s IS NOT NULL AND frequency_hz IS NULL"
          }
        ]
      }
    }
  }
}
