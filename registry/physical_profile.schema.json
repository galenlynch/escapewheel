{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://escapewheel.org/schemas/physical-profile/0.1.0",
  "title": "Escapewheel physical-profile descriptor",
  "type": "object",
  "required": ["$schema", "id", "logical_standard", "kind_interfaces", "interfaces"],
  "properties": {
    "$schema": {"const": "https://escapewheel.org/schemas/physical-profile/0.1.0"},
    "id": {"$ref": "#/$defs/id"},
    "logical_standard": {"$ref": "#/$defs/id"},
    "kind_interfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"oneOf": [{"$ref": "#/$defs/name"}, {"type": "null"}]}
    },
    "interfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/interface"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-v[0-9]+(?:\\.[0-9]+)*$"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "anchors": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ew-[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "ownership": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["packet", "external"]}
    },
    "parquet_floor": {
      "type": "object",
      "required": ["compressions", "encodings", "data_page_types", "encryption"],
      "properties": {
        "compressions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "encodings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "data_page_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "encryption": {"type": "string"}
      },
      "additionalProperties": false
    },
    "zarr_v3_floor": {
      "type": "object", "required": ["codec_sequences"],
      "properties": {"codec_sequences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
      "additionalProperties": false
    },
    "compressor": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "cname": {"type": "string"}}, "additionalProperties": false}
      ]
    },
    "zarr_v2_floor": {
      "type": "object", "required": ["metadata_patterns"],
      "properties": {"metadata_patterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "required": ["filters", "compressor"], "properties": {"filters": {"type": "null"}, "compressor": {"$ref": "#/$defs/compressor"}}, "additionalProperties": false}}},
      "additionalProperties": false
    },
    "variant": {
      "type": "object", "required": ["format_version", "ownership", "reader_floor", "anchors"],
      "properties": {
        "format_version": {"type": "integer", "minimum": 1},
        "ownership": {"$ref": "#/$defs/ownership"},
        "reader_floor": {"oneOf": [{"$ref": "#/$defs/zarr_v3_floor"}, {"$ref": "#/$defs/zarr_v2_floor"}]},
        "anchors": {"$ref": "#/$defs/anchors"}
      },
      "additionalProperties": false
    },
    "interface": {
      "type": "object",
      "required": ["realization", "access", "resource_form", "floor_role", "anchors"],
      "properties": {
        "realization": {"enum": ["materialized"]},
        "access": {"enum": ["logical_values"]},
        "resource_form": {"enum": ["single_object", "prefix"]},
        "ownership": {"$ref": "#/$defs/ownership"},
        "floor_role": {"enum": ["reader_and_packet_writer", "reader_only"]},
        "reader_floor": {"$ref": "#/$defs/parquet_floor"},
        "variants": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/variant"}},
        "anchors": {"$ref": "#/$defs/anchors"}
      },
      "oneOf": [
        {"required": ["ownership", "reader_floor"], "not": {"required": ["variants"]}},
        {"required": ["variants"], "not": {"anyOf": [{"required": ["ownership"]}, {"required": ["reader_floor"]}]}}
      ],
      "additionalProperties": false
    }
  }
}
