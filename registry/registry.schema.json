{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nwb-lake.org/schemas/registry/0.1.0",
  "title": "NWB-Lake schema registry",
  "description": "Shape of logical_schemas.json, per R2 \u00a79. Validates the registry document; column semantics are values within it, not JSON Schema types (R2 \u00a710).",
  "type": "object",
  "required": [
    "registry_version",
    "logical_standard_version",
    "tables"
  ],
  "additionalProperties": false,
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "semantic_standard_version": {
      "type": "string"
    },
    "logical_standard_version": {
      "type": "string"
    },
    "derived_from": {
      "type": "object",
      "description": "Optional record of how the registry was first produced.",
      "properties": {
        "specification": {
          "type": "string"
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^R\\d+$"
          }
        }
      }
    },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^([a-z][a-z0-9_]*)\\.[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/table"
      }
    },
    "extension_id": {
      "description": "Present on an extension registry; namespaces its tables (R17 \u00a72).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "extends": {
      "description": "The logical standard version this extension was written against (R17 \u00a75).",
      "type": "string"
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "required": [
        "columns",
        "primary_key",
        "references",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "primary_key": {
          "description": "Column names, or null for a table admitting duplicate rows (R7 \u00a72).",
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "sort": {
          "description": "Physical ordering a writer SHOULD apply (R2 \u00a76). Performance, not correctness.",
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "required": [
        "name",
        "type",
        "presence"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "description": "R2 \u00a74's Arrow-compatible vocabulary. Nested types are forbidden by R3 \u00a72.1.",
          "enum": [
            "string",
            "int32",
            "int64",
            "float32",
            "float64",
            "bool",
            "date",
            "timestamp",
            "json_string"
          ]
        },
        "presence": {
          "description": "R2 \u00a75. required: present, non-null. nullable: present, may be null. optional: may be absent.",
          "enum": [
            "required",
            "nullable",
            "optional"
          ]
        },
        "description": {
          "type": "string"
        },
        "enum": {
          "description": "Closed value set. A validator MUST reject values outside it.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "vocabulary": {
          "description": "Declared open (R8 \u00a74). A validator MUST NOT reject unrecognized values.",
          "const": "open"
        },
        "reserved_values": {
          "description": "Values with fixed meanings within an open vocabulary (R11 \u00a74). Not a closed set.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "not": {
        "required": [
          "enum",
          "vocabulary"
        ]
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "columns",
        "resource",
        "resource_columns"
      ],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "resource": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*)\\.[a-z][a-z0-9_]*$"
        },
        "resource_columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "level",
        "message",
        "sql"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "level": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string"
        },
        "sql": {
          "description": "Returns offending rows; empty is a pass (R2 \u00a77.3).",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
