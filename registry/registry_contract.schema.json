{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://escapewheel.org/schemas/registry-contract/0.1.0",
  "title": "Escapewheel registry conformance contract descriptor",
  "type": "object",
  "required": ["$schema", "id", "registry_schema", "semantic_standard", "logical_standard", "rule_languages", "phases", "invariants"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "id": {"$ref": "#/$defs/versioned_id"},
    "registry_schema": {"type": "string", "format": "uri"},
    "semantic_standard": {"$ref": "#/$defs/versioned_id"},
    "logical_standard": {"$ref": "#/$defs/versioned_id"},
    "rule_languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/versioned_id"}},
    "phases": {"const": ["json", "schema_selection", "shape", "contract_selection", "semantic", "rule_static", "external_domain"]},
    "invariants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/invariant"}}
  },
  "$defs": {
    "versioned_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-v[0-9]+(?:\\.[0-9]+)*$"},
    "invariant": {
      "type": "object",
      "required": ["id", "phase", "classes", "anchors"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
        "phase": {"enum": ["semantic", "rule_static", "external_domain"]},
        "classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["core", "extension"]}},
        "anchors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ew-[a-z0-9]+(?:-[a-z0-9]+)*$"}}
      }
    }
  }
}
